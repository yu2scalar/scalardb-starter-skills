// Generated by scalardb-starter-skills/scalardb-generate-springboot-starter
plugins {
	id 'java'
	id 'org.springframework.boot' version '4.1.1'
	id 'io.spring.dependency-management' version '1.1.7'
}

group = '{{GROUP}}'
version = '0.0.1-SNAPSHOT'

java {
	toolchain {
		languageVersion = JavaLanguageVersion.of(17)
	}
}

repositories {
	mavenCentral()
}

dependencies {
	implementation 'org.springframework.boot:spring-boot-starter-webmvc'
	// Retry style "Spring Retry library" ONLY — omit the next line for the default
	// Spring Framework built-in retry (org.springframework.core.retry, Boot 4+,
	// no extra dependency). Boot 4's BOM does not manage spring-retry, so the
	// version is explicit.
	implementation 'org.springframework.retry:spring-retry:2.0.13'
	implementation 'org.modelmapper:modelmapper:3.2.2'
	// CaseUtils used by the generated SqlRepository base class
	implementation 'org.apache.commons:commons-text:1.13.0'
	// ScalarDB Cluster Java (CRUD) API client
	implementation 'com.scalar-labs:scalardb-cluster-java-client-sdk:{{SCALARDB_VERSION}}'
	// ScalarDB SQL API
	implementation 'com.scalar-labs:scalardb-sql:{{SCALARDB_VERSION}}'
	implementation 'org.springdoc:springdoc-openapi-starter-webmvc-ui:3.0.3'
	compileOnly 'org.projectlombok:lombok'
	annotationProcessor 'org.projectlombok:lombok'
	testImplementation 'org.springframework.boot:spring-boot-starter-webmvc-test'
	testRuntimeOnly 'org.junit.platform:junit-platform-launcher'
}

tasks.named('test') {
	useJUnitPlatform()
}
